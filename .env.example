# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
CG_AWS_ACCOUNT_ID=your_12_digit_account_id

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cloud_guardian

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1

# Auth
SECRET_KEY=change_this_to_a_random_64_char_hex_string

# Detection
CG_LOOKBACK_MINUTES=15
CG_POLL_INTERVAL=60
CG_ALERT_THRESHOLD=30
CG_REMEDIATION_ENABLED=false
CG_SNS_TOPIC_ARN=

# Storage (set to false for PostgreSQL production mode)
CG_USE_LOCAL_STORE=true

# Frontend
VITE_API_URL=http://localhost:8000

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products at https://dashboard.stripe.com/test/products)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Frontend URL (for Stripe redirect after checkout)
FRONTEND_URL=http://localhost:3000

# Synthetic simulator report output directory (CLI default)
CG_SIMULATION_DIR=./data/simulations
